    "start": "next start",
    "lint": "eslint",
    "seed": "tsx prisma/seed.ts",
    "prisma:migrate": "prisma migrate dev",
    "db:migrate": "prisma migrate deploy",
    "db:migrate-data": "node scripts/migrate-db-data.js",
    "whatsapp": "tsx scripts/start-whatsapp.ts",
    "whatsapp:service": "tsx whatsapp-server/start-service.ts",
    "gateway": "tsx whatsapp-server/gateway.ts",
    "test:e2e": "playwright test"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@hapi/boom": "^10.0.1",
    "@prisma/adapter-pg": "^7.9.0",
    "@prisma/client": "^7.9.0",
    "@types/bcrypt": "^6.0.0",
    "@whiskeysockets/baileys": "^6.7.24",
    "bcrypt": "^6.0.0",
    "clsx": "^2.1.1",
    "cookies": "^0.9.1",
    "framer-motion": "^12.42.2",
    "jose": "^6.2.4",
    "jsbarcode": "^3.12.3",
    "lucide-react": "^1.26.0",
    "next": "16.2.11",
    "pg": "^8.22.0",
    "pino": "^10.3.1",
    "prisma": "^7.9.0",
    "qrcode-terminal": "^0.12.0",
    "qrcode.react": "^4.2.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "recharts": "^3.10.0",
    "tailwind-merge": "^3.6.0",
    "tsx": "^4.23.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.45.0",
    "@tailwindcss/postcss": "^4",
    "@types/localtunnel": "^2.0.4",
    "@types/node": "^20",
    "@types/qrcode-terminal": "^0.12.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.11",
